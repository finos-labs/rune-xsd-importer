<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://example.com/multi"
           xmlns:tns="http://example.com/multi"
           xmlns:common="http://example.com/common"
           elementFormDefault="qualified">

    <xs:import namespace="http://example.com/common" schemaLocation="base-common.xsd"/>

    <xs:simpleType name="RoleEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="ADMIN"/>
            <xs:enumeration value="USER"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="UserRecord">
        <xs:sequence>
            <xs:element name="id" type="xs:string"/>
            <xs:element name="role" type="tns:RoleEnum"/>
            <xs:element name="status" type="common:StatusEnum"/>
            <xs:choice>
                <xs:element name="lastLogin" type="xs:dateTime"/>
                <xs:group ref="common:AuditGroup"/>
            </xs:choice>
        </xs:sequence>
        <xs:attribute ref="common:auditCode" use="required"/>
    </xs:complexType>

    <xs:element name="UserRecord" type="tns:UserRecord"/>
    <xs:element name="orphanElement" type="xs:string"/>

</xs:schema>

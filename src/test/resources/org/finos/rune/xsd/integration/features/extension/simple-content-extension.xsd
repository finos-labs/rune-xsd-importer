<?xml version="1.0" encoding="UTF-8"?>
<xs:schema
        xmlns:xs="http://www.w3.org/2001/XMLSchema"
        xmlns:tns="http://example.com/rune/test/extension/simplecontent"
        targetNamespace="http://example.com/rune/test/extension/simplecontent"
        elementFormDefault="qualified"
        attributeFormDefault="unqualified">

    <xs:element name="testSimpleContentExt" type="tns:TextWithAttrs"/>

    <xs:complexType name="TextWithAttrs">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="lang" type="xs:language" use="required"/>
                <xs:attribute name="version" type="xs:int" default="1"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>
</xs:schema>

<?xml version="1.0" encoding="UTF-8"?>
<xs:schema
        xmlns:xs="http://www.w3.org/2001/XMLSchema"
        xmlns:tns="http://example.com/rune/dependencies/recursive"
        targetNamespace="http://example.com/rune/dependencies/recursive"
        elementFormDefault="qualified"
        attributeFormDefault="unqualified">

    <xs:element name="recursiveDocument" type="tns:RecursiveDocumentType"/>

    <xs:complexType name="RecursiveDocumentType">
        <xs:sequence>
            <xs:element name="portfolio" type="tns:Portfolio"/>
            <xs:element name="formula" type="tns:Formula"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="Portfolio">
        <xs:sequence>
            <xs:element name="name" type="xs:string"/>
            <xs:element name="child" type="tns:Portfolio" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="Formula">
        <xs:sequence>
            <xs:element name="expression" type="xs:string"/>
            <xs:element name="component" type="tns:FormulaComponent" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="FormulaComponent">
        <xs:sequence>
            <xs:element name="label" type="xs:string"/>
            <xs:element name="nestedFormula" type="tns:Formula" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

</xs:schema>

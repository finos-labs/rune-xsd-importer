<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://example.com/rune/test/refs/collision"
           targetNamespace="http://example.com/rune/test/refs/collision"
           elementFormDefault="qualified">

    <xs:complexType name="Conflict">
        <xs:sequence>
            <xs:element name="reason" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:element name="conflict" type="tns:Conflict"/>

    <xs:element name="root">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="tns:conflict"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>

<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://example.com/rune/test/refs/pattern"
           targetNamespace="http://example.com/rune/test/refs/pattern"
           elementFormDefault="qualified">

    <xs:element name="patternRefEl">
        <xs:simpleType>
            <xs:restriction base="xs:string">
                <xs:pattern value="\d{5}"/>
            </xs:restriction>
        </xs:simpleType>
    </xs:element>

    <xs:element name="fullRefEl">
        <xs:simpleType>
            <xs:restriction base="xs:int">
                <xs:minInclusive value="0"/>
                <xs:maxInclusive value="100"/>
            </xs:restriction>
        </xs:simpleType>
    </xs:element>

    <xs:element name="root">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="tns:patternRefEl"/>
                <xs:element ref="tns:fullRefEl"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>

<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://example.com/global"
           xmlns:tns="http://example.com/global"
           elementFormDefault="qualified">

    <xs:element name="GlobalRoot" type="tns:RootType"/>

    <xs:complexType name="SimpleXSType">
        <xs:sequence>
            <xs:element name="term" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:element name="simpleXsType" type="tns:SimpleXSType"/>

    <xs:complexType name="RootType">
        <xs:sequence>
            <xs:element name="id" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:element name="InlineRoot">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="status" type="xs:string"/>
                <xs:element name="simpleXsType" type="tns:SimpleXSType" minOccurs="0"/>
            </xs:sequence>
            <xs:attribute name="version" type="xs:int"/>
        </xs:complexType>
    </xs:element>

</xs:schema>

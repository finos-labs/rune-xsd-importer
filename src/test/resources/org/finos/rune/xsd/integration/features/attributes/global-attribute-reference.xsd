<?xml version="1.0" encoding="UTF-8"?>
<xs:schema
        xmlns:xs="http://www.w3.org/2001/XMLSchema"
        xmlns:tns="http://example.com/rune/attrref"
        targetNamespace="http://example.com/rune/attrref"
        elementFormDefault="qualified"
        attributeFormDefault="unqualified">

    <xs:attribute name="globalId" type="xs:string"/>
    <xs:attribute name="globalCode" type="xs:int"/>

    <xs:complexType name="GlobalAttributeReferenceType">
        <xs:sequence>
            <xs:element name="name" type="xs:string"/>
        </xs:sequence>

        <xs:attribute ref="tns:globalId" use="required"/>
        <xs:attribute ref="tns:globalCode"/>
        <xs:attribute name="localFlag" type="xs:boolean" use="optional"/>
    </xs:complexType>

    <xs:element name="globalAttributeReference" type="tns:GlobalAttributeReferenceType"/>
</xs:schema>

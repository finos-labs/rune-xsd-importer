<?xml version="1.0" encoding="UTF-8"?>
<xs:schema
        xmlns:xs="http://www.w3.org/2001/XMLSchema"
        xmlns:tns="http://example.com/rune/restriction"
        targetNamespace="http://example.com/rune/restriction"
        elementFormDefault="qualified"
        attributeFormDefault="unqualified">

    <xs:simpleType name="SideEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="BUY"/>
            <xs:enumeration value="SELL"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="AlphaCode">
        <xs:restriction base="xs:string">
            <xs:length value="3"/>
            <xs:pattern value="[A-Z]{3}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="Amount2dp">
        <xs:restriction base="xs:decimal">
            <xs:minInclusive value="0"/>
            <xs:totalDigits value="18"/>
            <xs:fractionDigits value="2"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="SmallInt">
        <xs:restriction base="xs:int">
            <xs:minInclusive value="-10"/>
            <xs:maxInclusive value="10"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="RestrictionType">
        <xs:sequence>
            <xs:element name="side" type="tns:SideEnum"/>
            <xs:element name="ccy" type="tns:AlphaCode"/>
            <xs:element name="amount" type="tns:Amount2dp"/>
            <xs:element name="qty" type="tns:SmallInt"/>
        </xs:sequence>
    </xs:complexType>

    <xs:element name="restrictionTest" type="tns:RestrictionType"/>

</xs:schema>

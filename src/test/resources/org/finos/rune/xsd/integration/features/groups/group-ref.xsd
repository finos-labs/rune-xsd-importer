<?xml version="1.0" encoding="UTF-8"?>
<xs:schema
        xmlns:xs="http://www.w3.org/2001/XMLSchema"
        xmlns:tns="http://example.com/rune/test/groups"
        targetNamespace="http://example.com/rune/test/groups"
        elementFormDefault="qualified"
        attributeFormDefault="unqualified">

    <xs:group name="CommonFields">
        <xs:sequence>
            <xs:element name="groupString" type="xs:string"/>
            <xs:element name="groupInt" type="xs:int" minOccurs="0"/>
        </xs:sequence>
    </xs:group>

    <xs:element name="testGroup" type="tns:GroupTestType"/>

    <xs:complexType name="GroupTestType">
        <xs:sequence>
            <xs:element name="beforeGroup" type="xs:boolean"/>
            <xs:group ref="tns:CommonFields"/>
            <xs:element name="afterGroup" type="xs:date"/>
        </xs:sequence>
    </xs:complexType>

</xs:schema>

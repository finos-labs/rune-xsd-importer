<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://example.com/advanced"
           xmlns:tns="http://example.com/advanced"
           elementFormDefault="qualified">

    <xs:simpleType name="SKU">
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Z]{3}-\d{3}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="Age">
        <xs:restriction base="xs:int">
            <xs:minInclusive value="0"/>
            <xs:maxInclusive value="120"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="ZipCode">
        <xs:restriction base="xs:string">
            <xs:length value="5"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="Color">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Red"/>
            <xs:enumeration value="Green"/>
            <xs:enumeration value="Blue"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="NumberList">
        <xs:list itemType="xs:int"/>
    </xs:simpleType>

    <xs:simpleType name="ScoreOrNA">
        <xs:union memberTypes="xs:int">
            <xs:simpleType>
                <xs:restriction base="xs:string">
                    <xs:enumeration value="N/A"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:union>
    </xs:simpleType>

    <xs:simpleType name="ThreeNumbers">
        <xs:restriction base="tns:NumberList">
            <xs:length value="3"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:element name="DataCollection">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="productSku" type="tns:SKU"/>
                <xs:element name="userAge" type="tns:Age"/>
                <xs:element name="zip" type="tns:ZipCode"/>
                <xs:element name="favColor" type="tns:Color"/>
                <xs:element name="allScores" type="tns:NumberList"/>
                <xs:element name="finalScore" type="tns:ScoreOrNA"/>
                <xs:element name="coordinates" type="tns:ThreeNumbers"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>

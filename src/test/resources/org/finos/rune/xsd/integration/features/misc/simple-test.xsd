<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://example.com/simple"
           xmlns:tns="http://example.com/simple"
           elementFormDefault="qualified">

    <xs:element name="TestObject" type="tns:TestObjectType"/>

    <xs:simpleType name="SideEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Buy"/>
            <xs:enumeration value="Sell"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="TestObjectType">
        <xs:sequence>
            <xs:element name="name" type="xs:string" minOccurs="1" maxOccurs="1"/>
            <xs:element name="count" type="xs:int" minOccurs="0" maxOccurs="1"/>
            <xs:element name="side" type="tns:SideEnum" minOccurs="1" maxOccurs="1"/>
        </xs:sequence>
    </xs:complexType>
</xs:schema>
<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
        targetNamespace="urn:example:unprefixed-builtin">
    <simpleType name="EncodedValue">
        <restriction base="base64Binary"/>
    </simpleType>
    <simpleType name="TextValue"><restriction base="string"/></simpleType>
    <simpleType name="IntegerValue"><restriction base="integer"/></simpleType>
    <simpleType name="DecimalValue"><restriction base="decimal"/></simpleType>
    <simpleType name="BooleanValue"><restriction base="boolean"/></simpleType>
    <simpleType name="DateValue"><restriction base="date"/></simpleType>
    <complexType name="Container">
        <sequence>
            <element name="data" type="base64Binary"/>
            <element name="count" type="integer"/>
        </sequence>
        <attribute name="identifier" type="ID"/>
    </complexType>
    <complexType name="EncodedContent">
        <simpleContent>
            <extension base="base64Binary">
                <attribute name="identifier" type="ID"/>
            </extension>
        </simpleContent>
    </complexType>
</schema>
